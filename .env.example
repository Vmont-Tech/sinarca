# Ambiente da API
APP_ENV=development
PORT=5680
PUBLIC_WEB_URL=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
SESSION_TTL_HOURS=6
ALLOW_DEMO_AUTH_FALLBACK=false
MAX_UPLOAD_BYTES=10485760

# Frontend Vite
VITE_API_URL=http://127.0.0.1:5680/api/v1
VITE_ALLOW_LOCAL_AUTH_FALLBACK=false
VITE_SESSION_TTL_MS=21600000

# Supabase/Postgres alvo da Phase 1
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET_KEY=change-me

# Stellar/Soroban
STELLAR_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ISSUER_PUBLIC_KEY=
STELLAR_ISSUER_SECRET_KEY=
STELLAR_DISTRIBUTOR_PUBLIC_KEY=
STELLAR_DISTRIBUTOR_SECRET_KEY=
STELLAR_ASSET_CODE=SINARCA

# Provedores financeiros e cross-chain
ETHERFUSE_API_URL=
ETHERFUSE_API_KEY=
TRANSFERO_API_URL=
TRANSFERO_API_KEY=
POLYGON_RPC_URL=
POLYGON_VAULT_ADDRESS=

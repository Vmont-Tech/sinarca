# Runtime
APP_ENV=production
BACKEND_RUNTIME=backend_app
PORT=5680
API_PORT=5680
WEB_PORT=80
PUBLIC_WEB_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
SESSION_TTL_HOURS=6
MAX_UPLOAD_BYTES=10485760

# Frontend Vite
VITE_API_URL=/api/v1
VITE_SESSION_TTL_MS=21600000

# Supabase/Postgres externo
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLIC_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_JWT_SECRET=replace-with-local-dev-jwt-secret
JWT_SECRET_KEY=change-me

# Stellar/Soroban
STELLAR_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ISSUER_PUBLIC_KEY=replace-with-stellar-issuer-public-key
STELLAR_ISSUER_SECRET_KEY=replace-with-stellar-issuer-secret-key
STELLAR_DISTRIBUTOR_PUBLIC_KEY=replace-with-stellar-distributor-public-key
STELLAR_DISTRIBUTOR_SECRET_KEY=replace-with-stellar-distributor-secret-key
STELLAR_ASSET_CODE=SINARCA

# Provedores financeiros e cross-chain
ETHERFUSE_API_URL=https://sandbox.etherfuse.example.com
ETHERFUSE_API_KEY=replace-with-etherfuse-api-key
TRANSFERO_API_URL=https://sandbox.transfero.example.com
TRANSFERO_API_KEY=replace-with-transfero-api-key
POLYGON_RPC_URL=https://polygon-testnet-rpc.example.com
POLYGON_VAULT_ADDRESS=0x0000000000000000000000000000000000000000

# Copernicus Data Space Ecosystem (Phase 5 / D-10) — conta gratuita em dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=replace-with-copernicus-client-id
COPERNICUS_CLIENT_SECRET=replace-with-copernicus-client-secret
